# Server-only. Required in production.
DATABASE_URL="postgresql://DB_USER:DB_PASSWORD@DB_HOST:5432/DB_NAME?schema=public"
JWT_ACCESS_SECRET="GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS"
JWT_REFRESH_SECRET="GENERATE_A_DIFFERENT_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS"
CORS_ALLOWED_ORIGINS="https://TEACHER_WEB_ORIGIN"

# Server-only. Redis is optional for the core API; omit it when disabled.
REDIS_URL="redis://REDIS_HOST:6379"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS="7"
PORT="3001"
PRESENCE_OFFLINE_SECONDS="30"
HEALTH_TIMEOUT_MS="1500"

# Public/client-visible build variables. Never put secrets in these values.
NEXT_PUBLIC_API_URL="https://PUBLIC_API_ORIGIN/v1"
EXPO_PUBLIC_API_URL="https://PUBLIC_API_ORIGIN/v1"
