# Copy to an ignored deploy/.env.rehearsal for the local rehearsal.
# Use unique randomly generated values; never commit the populated file.
COMPOSE_PROJECT_NAME=carbon-trader-rehearsal
INGRESS_PORT=8088
POSTGRES_USER=carbon
POSTGRES_PASSWORD=GENERATE_A_STRONG_DATABASE_PASSWORD
POSTGRES_DB=carbon_trader
DATABASE_URL=postgresql://carbon:GENERATE_A_STRONG_DATABASE_PASSWORD@postgres:5432/carbon_trader?schema=public
REDIS_URL=redis://redis:6379
JWT_ACCESS_SECRET=GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
JWT_REFRESH_SECRET=GENERATE_A_DIFFERENT_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
CORS_ALLOWED_ORIGINS=http://localhost:8088
NEXT_PUBLIC_API_URL=http://localhost:8088/v1
EXPO_PUBLIC_API_URL=http://HOST_REACHABLE_FROM_DEVICE:8088/v1
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
PRESENCE_OFFLINE_SECONDS=30
HEALTH_TIMEOUT_MS=1500

